    <record id="product_product_delivery_cdek" model="product.product">
        <field name="name">CDEK Delivery</field>
        <field name="default_code">cdek</field>
        <field name="type">service</field>
        <field name="categ_id" ref="delivery.product_category_deliveries" />
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="False" />
        <field name="list_price">0.0</field>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_product_cdek_insurance" model="product.product">
        <field name="name">CDEK: Insurance</field>
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="False" />
        <field name="detailed_type">service</field>
        <field name="cdek_reference">INSURANCE</field>
        <field name="default_code">INSURANCE</field>
        <field name="description" type="html">
            <p>Providing insurance protection for the parcel.
For "E-commerce" order types, the insurance surcharge is calculated from the declared value of the shipment and the service is charged automatically; not allowed for independent entry in services.code.
For "Delivery" order types, if the service is not provided by the user in services.code, it is added automatically with parameter services.parameter = 1. This value will be processed by the system so that the insurance will be free. However, we recommend passing the actual declared value of the shipment.</p>
        </field>
    </record>

    <record id="product_product_cdek_take_sender" model="product.product">
        <field name="name">CDEK: Pickup in Sender's City</field>
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="False" />
        <field name="detailed_type">service</field>
        <field name="cdek_reference">TAKE_SENDER</field>
        <field name="default_code">TAKE_SENDER</field>
        <field name="description" type="html">
            <p
            >Additional service for picking up cargo from the client to the CDEK office within the city as part of "LTL (consolidated cargo)" transportation. Additional pickup service in the sender's city, provided that the delivery tariff has "from warehouse" mode (not available for Parcel tariffs).</p>
        </field>
    </record>

    <record id="product_product_cdek_deliv_receiver" model="product.product">
