        <field name="cdek_reference">DELIV_RECEIVER</field>
        <field name="default_code">DELIV_RECEIVER</field>
        <field name="description" type="html">
            <p
            >Additional service for cargo delivery in the recipient's city, provided that the delivery tariff has "to warehouse" mode (only for "LTL" tariff). Not applicable to postamat orders.</p>
        </field>
    </record>

    <record id="product_product_cdek_trying_on" model="product.product">
